# Video pipeline
export AICAM_GATEWAY_IP=127.0.0.1
export AICAM_GATEWAY_PORT=8080
export AICAM_SENSOR_ID=0
export AICAM_FPS=30
export AICAM_IQ_DIR=/etc/iqfiles
export AICAM_BTNR_STRENGTH=0.25
export AICAM_VIDEO_DEVICE=/dev/video13
export AICAM_WIDTH=1920
export AICAM_HEIGHT=1080
export AICAM_BITRATE_KBPS=8192
export AICAM_GOP=30

# Queue and logging
export AICAM_ENCODE_QUEUE=5
export AICAM_AI_QUEUE=3
export AICAM_VERBOSE_ENCODE=0
export AICAM_EVENT_JSONL=logs/events.jsonl
export AICAM_METRICS_JSONL=logs/metrics.jsonl
export AICAM_METRICS_INTERVAL=5
export AICAM_OVERLAY_ENABLE=1
export AICAM_OVERLAY_THICKNESS=4
export AICAM_OVERLAY_STALE_FRAMES=30

# AI pipeline
export AICAM_AI_ENABLE=1
export AICAM_RKNN_MODEL=/userdata/aicam/models/yolov5n_fp.rknn
export AICAM_LABELS=/userdata/aicam/models/coco_80_labels.txt
export AICAM_INFER_EVERY_N=7
export AICAM_PREPROCESS_BACKEND=rga
export AICAM_SCORE_THRESHOLD=0.35
export AICAM_NMS_THRESHOLD=0.45
export AICAM_MAX_RESULTS=20

# YOLOv5 commonly uses objectness; set to 0 for YOLOv8-style decoded outputs when needed.
export AICAM_HAS_OBJECTNESS=1

# Supported values: xywh, xyxy
export AICAM_BOX_FORMAT=xywh
